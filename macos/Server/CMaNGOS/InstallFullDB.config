## classic-db's InstallFullDB.sh settings for the launcher's CMaNGOS server.
MYSQL_HOST="database"
MYSQL_PORT="3306"
MYSQL_USERNAME="mangos"
MYSQL_PASSWORD="mangos"
MYSQL_USERIP="%"
MYSQL_COLSTAT=""
WORLD_DB_NAME="classicmangos"
REALM_DB_NAME="classicrealmd"
CHAR_DB_NAME="classiccharacters"
LOGS_DB_NAME="classiclogs"
MYSQL_PATH="/usr/bin/mariadb"
MYSQL_DUMP_PATH="/usr/bin/mariadb-dump"
CORE_PATH="/opt/cmangos/core"
LOCALES="NO"
DEV_UPDATES="NO"
AHBOT="YES"
PLAYERBOTS_DB="YES"
FORCE_WAIT="NO"
